<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <!--
        运行方式（需先建库建表，见 db/schema.sql + db/data.sql）：
          1) 在根目录：mvn -pl library-storage mybatis-generator:generate
          2) 或进入 library-storage：mvn mybatis-generator:generate
        注意：会覆盖 storage/po、storage/mapper、resources/mapper 下同表已有的生成文件；
             手写的自定义查询（如 BookMapper.search/countSearch、CategoryMapper.selectEnabled）
             不会生成，需在生成后自行补回。
    -->
    <context id="mysql" targetRuntime="MyBatis3Simple" defaultModelType="flat">

        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <!-- 数据库连接：改成你本机的账号密码 -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/library?useSSL=false&amp;serverTimezone=Asia/Shanghai&amp;characterEncoding=utf8&amp;allowPublicKeyRetrieval=true"
                        userId="root"
                        password="123456"/>

        <!-- 时间列映射为 java.time（LocalDateTime/LocalDate/LocalTime） -->
        <javaTypeResolver>
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <!-- PO -> org.example.library.storage.po -->
        <javaModelGenerator targetPackage="org.example.library.storage.po" targetProject="src/main/java">
            <property name="enableSubPackages" value="false"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- Mapper XML -> src/main/resources/mapper -->
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources">
            <property name="enableSubPackages" value="false"/>
        </sqlMapGenerator>

        <!-- Mapper 接口 -> org.example.library.storage.mapper -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="org.example.library.storage.mapper"
                             targetProject="src/main/java">
            <property name="enableSubPackages" value="false"/>
        </javaClientGenerator>

        <!-- 要生成的表（TINYINT/SMALLINT 列显式映射为 Integer，与项目约定一致） -->
        <table tableName="categories" domainObjectName="CategoryPO">
            <columnOverride column="enabled" javaType="java.lang.Integer" jdbcType="TINYINT"/>
        </table>
        <table tableName="books" domainObjectName="BookPO">
            <columnOverride column="enabled" javaType="java.lang.Integer" jdbcType="TINYINT"/>
            <columnOverride column="publish_year" javaType="java.lang.Integer" jdbcType="SMALLINT"/>
        </table>
        <table tableName="book_copy" domainObjectName="BookCopyPO"/>
        <table tableName="users" domainObjectName="UserPO">
            <columnOverride column="status" javaType="java.lang.Integer" jdbcType="TINYINT"/>
        </table>
        <table tableName="borrow_record" domainObjectName="BorrowRecordPO">
            <columnOverride column="renew_count" javaType="java.lang.Integer" jdbcType="TINYINT"/>
        </table>
        <table tableName="favorite" domainObjectName="FavoritePO"/>
        <table tableName="notification" domainObjectName="NotificationPO"/>
    </context>
</generatorConfiguration>
