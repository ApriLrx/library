<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.library.storage.mapper.CategoryMapper">

    <sql id="columns">id, name, enabled, created_at, updated_at</sql>

    <select id="selectEnabled" resultType="org.example.library.storage.po.CategoryPO">
        SELECT <include refid="columns"/>
        FROM categories
        WHERE enabled = 1
        ORDER BY id
    </select>

    <select id="selectAll" resultType="org.example.library.storage.po.CategoryPO">
        SELECT <include refid="columns"/>
        FROM categories
        ORDER BY id
    </select>

    <select id="selectById" resultType="org.example.library.storage.po.CategoryPO">
        SELECT <include refid="columns"/>
        FROM categories
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="org.example.library.storage.po.CategoryPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name, enabled) VALUES (#{name}, #{enabled})
    </insert>

    <update id="update" parameterType="org.example.library.storage.po.CategoryPO">
        UPDATE categories SET name = #{name} WHERE id = #{id}
    </update>

    <update id="updateEnabled">
        UPDATE categories SET enabled = #{enabled} WHERE id = #{id}
    </update>

    <select id="countByName" resultType="long">
        SELECT COUNT(*) FROM categories WHERE name = #{name}
    </select>

    <select id="countByNameExcludeId" resultType="long">
        SELECT COUNT(*) FROM categories WHERE name = #{name} AND id != #{id}
    </select>

</mapper>
